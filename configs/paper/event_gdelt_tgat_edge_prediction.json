{
  "data": {
    "source": "${STARRYGL_DATA_ROOT}/starrygl/GDELT",
    "temporal_representation": "event_stream"
  },
  "backbone": {
    "name": "tgat",
    "in_dim": 413,
    "edge_dim": 182,
    "hidden_dim": 100,
    "out_dim": 100,
    "time_dim": 100,
    "num_layers": 2,
    "num_heads": 2,
    "temporal_representation": "event_stream",
    "spatial_aggregation": "sampled_neighbor",
    "coupling": "decoupled",
    "state": "stateless"
  },
  "task": {
    "name": "edge_prediction",
    "services": {
      "negative_sampling": {
        "ratio": 1,
        "mode": "dst",
        "train": {"policy": "random", "local_probability": 0.9, "remote_probability": 0.1},
        "eval": {"policy": "random"},
        "test": {"policy": "random"}
      }
    }
  },
  "runtime": {
    "temporal_state": {"consistency": "exact", "max_staleness": 0},
    "sampling": {
      "mode": "neighbor",
      "window": {"policy": "event_window"},
      "neighbor": {
        "fanouts": [10, 10],
        "policy": "uniform",
        "workers": 32,
        "boundary_sampling": {"enabled": true, "probability": 0.1}
      }
    },
    "preprocess": {
      "partition_backend": "speed_partition",
      "speed_partition_beta": 0.1,
      "chunks_per_rank": 128,
      "hot_node_ratio": 0.1,
      "time_split": "batch",
      "target_batch_size": 3000,
      "split_ratios": [0.7, 0.15, 0.15]
    },
    "gradient_sync": "ddp",
    "train": {
      "batch_size": 3000,
      "epochs": 10,
      "optimizer": "adam",
      "lr": 0.0001,
      "weight_decay": 0.0,
      "dropout": 0.1,
      "att_dropout": 0.1
    }
  }
}
