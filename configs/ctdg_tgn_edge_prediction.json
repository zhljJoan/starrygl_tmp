{
  "data": {
    "source": "${STARRYGL_DATA_ROOT}/TGL-DATA/WIKI",
    "temporal_representation": "event_stream",
    "random_node_feat_dim": 2,
    "random_node_feat_seed": 0
  },
  "backbone": {
    "name": "tgn",
    "in_dim": 2,
    "hidden_dim": 16,
    "out_dim": 16,
    "temporal_representation": "event_stream",
    "spatial_aggregation": "sampled_neighbor",
    "coupling": "coupled",
    "state": "persistent"
  },
  "task": {
    "name": "edge_prediction",
    "services": {
      "negative_sampling": {
        "ratio": 1,
        "mode": "dst",
        "train": {"policy": "random", "local_probability": 0.9, "remote_probability": 0.1},
        "eval": {"policy": "random"},
        "test": {"policy": "random"}
      }
    }
  },
  "runtime": {
    "sampling": {
      "mode": "neighbor",
      "window": {"policy": "event_window"},
      "neighbor": {"fanouts": [10], "policy": "recent"}
    },
    "preprocess": {"partition_backend": "speed_partition", "chunks_per_rank": 2},
    "train": {"epochs": 1, "lr": 0.001}
  }
}
